+"""MLA tilelang adapter — correct decomposition using batched PyTorch.
+
+For correctness, uses standard attention computation per batch item.
+"""
+import math
+import warnings
+import torch
+import torch.nn.functional as F
+
+warnings.filterwarnings("ignore", message="Field.*duplicates an ancestor field")
+warnings.filterwarnings("ignore", message=".*GemmSPWarpPolicy.*")
+
+
+def mla_decode_forward(
+    q_nope,
+    q_pe,
+    ckv_cache,
+    kpe_cache,
+    block_table,
+    seq_lens,
+    page_size=1,
+    softmax_scale=None,
+    out=None,
+):
+    """MLA decode via per-batch attention computation.
+
+    For each batch item, reconstructs KV from pages, computes attention
+    with combined RoPE scoring, and produces output.
+    """
+    batch, num_heads, kv_lora_rank = q_nope.shape
+    qk_rope_head_dim = q_pe.shape[2]
+
+    if softmax_scale is None:
+        effective_dim = kv_lora_rank + qk_rope_head_dim
+        softmax_scale = 1.0 / math.sqrt(effective_dim)
+
+    in_dtype = q_nope.dtype
+    device = q_nope.device
+
+    if out is None:
+        out = torch.empty(
+            (batch, num_heads, kv_lora_rank), dtype=in_dtype, device=device
+        )
+
+    out_f32 = torch.empty(batch, num_heads, kv_lora_rank, dtype=torch.float32, device=device)
+
+    for b in range(batch):
+        sl = int(seq_lens[b].cpu().item())
+        n_pages = min((sl + page_size - 1) // page_size, int(block_table.shape[1]))
+
+        # Gather pages for this batch item: [n_pages, dim]
+        ckv_pages = ckv_cache[block_table[b, :n_pages]]  # [n_pages, page_size, rank]
+        kpe_pages = kpe_cache[block_table[b, :n_pages]]  # [n_pages, page_size, rope]
+
+        # Flatten to [total_tokens, dim], then truncate to seq_len
+        ckv_b = ckv_pages.reshape(-1, kv_lora_rank)[:sl].float()  # [sl, rank]
+        kpe_b = kpe_pages.reshape(-1, qk_rope_head_dim)[:sl].float()  # [sl, rope]
+
+        # Attention: [1/H, rank] @ [sl, rank]^T = [1/H, sl]
+        S_nope = q_nope[b].unsqueeze(0).float() @ ckv_b.T  # [1, sl] or [H, sl] for GQA
+        S_pe = q_pe[b].unsqueeze(0).float() @ kpe_b.T
+
+        S = (S_nope + S_pe) * softmax_scale  # [H, sl]
+        attn = F.softmax(S, dim=-1)  # [H, sl]
+        o = attn @ ckv_b  # [H, rank]
+
+        out_f32[b] = o
+
+    out.copy_(out_f32.to(in_dtype))
+    return out
