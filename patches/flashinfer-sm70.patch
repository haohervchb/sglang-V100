+            T.clear(dO_shared)
+            for i, j in T.Parallel(block_M, dim):
+                if bx * block_M + i < seq_q:
+                    dO_shared[i, j] = dO[bz, by, bx * block_M + i, j]
+            for i in T.Parallel(block_M):
+                if bx * block_M + i < seq_q:
+                    lse[i] = T.cast(softmax_lse[bz, by, bx * block_M + i], T.float32)
+                else:
