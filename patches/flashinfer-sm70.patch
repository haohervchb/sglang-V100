new file mode 100644
index 00000000..82590b51
--- /dev/null
+++ b/flashinfer/backends/tilelang_fa_v100/_ragged_adapter.py
@@ -0,0 +1,82 @@
+"""Adapter: ragged attention via TileLang (SM70).
+
+Strategy: reshape flat K/V into pages of size 1, then dispatch to
+the proven paged kernel.  This avoids a second kernel codepath while
+keeping ragged tensors usable.
+"""
+import math
+import warnings
+import torch
+
+warnings.filterwarnings("ignore", message="Field.*duplicates an ancestor field")
+warnings.filterwarnings("ignore", message=".*GemmSPWarpPolicy.*")
+
+from .interface import _paged_forward
+
+
+def ragged_forward(
+    q,
+    k,
+    v,
+    qo_indptr,
+    kv_indptr,
+    prefix_kv_lens,
+    out=None,
+    num_kv_heads=None,
+    softmax_scale=None,
+    causal=True,
+):
+    """Ragged (varlen) attention: K/V are [total_kv, heads_kv, dim] flat.
+
+    Converts flat K/V into paged layout with page_size=1:
+      k_paged: [total_kv, 1, heads_kv, dim]
+      v_paged: [total_kv, 1, heads_kv, dim]
+    block_table: [batch, max_kv_per_seq] — identity mapping into flat tensor
+    """
+    num_tokens, num_heads, D = q.shape
+    heads_kv = num_kv_heads or k.shape[1]
+    batch = len(qo_indptr) - 1
+    total_kv = k.shape[0]
+
+    page_size = 1
+    max_blocks = max(
+        int(kv_indptr[b + 1].item()) - int(kv_indptr[b].item())
+        for b in range(batch)
+    )
+
+    sm_scale = softmax_scale if softmax_scale is not None else 1.0 / math.sqrt(D)
+
+    # Reshape K/V from [total_kv, heads_kv, dim] to [total_kv, 1, heads_kv, dim]
+    k_paged = k.view(total_kv, page_size, heads_kv, D)
+    v_paged = v.view(total_kv, page_size, heads_kv, D)
+
+    # Build block_table: each page = 1 token, identity mapping
+    block_table = torch.zeros((batch, max_blocks), dtype=torch.int, device=q.device)
+    idx = 0
+    seq_lens = torch.zeros(batch, dtype=torch.int32, device=q.device)
+    for b in range(batch):
+        kv_start = int(kv_indptr[b].item())
+        kv_end = int(kv_indptr[b + 1].item())
+        seq_len = kv_end - kv_start
+        seq_lens[b] = seq_len
+        block_table[b, :seq_len] = torch.arange(kv_start, kv_end, dtype=torch.int, device=q.device)
+        idx += seq_len
+
+    prefix_kv = prefix_kv_lens if prefix_kv_lens is not None else torch.zeros(
+        batch, dtype=torch.int32, device=q.device
+    )
+
+    return _paged_forward(
+        q,
+        k_paged,
+        v_paged,
+        block_table,
+        seq_lens,
+        qo_indptr,
+        prefix_kv,
+        out=out,
+        block_size=page_size,
+        num_kv_heads=heads_kv,
+        softmax_scale=sm_scale,
+        causal=causal,
+    )
diff --git a/flashinfer/backends/tilelang_fa_v100/_utils.py b/flashinfer/backends/tilelang_fa_v100/_utils.py
new file mode 100644
index 00000000..a532940d
--- /dev/null
+++ b/flashinfer/backends/tilelang_fa_v100/_utils.py
@@ -0,0 +1,27 @@
+"""Shared utilities for TileLang FA V100 kernels."""
+
+
+def _is_valid_gemm2(block_M, dim, num_warps):
+    """Check if GEMM 2 (M=block_M, N=dim) is valid for SM70 with Square policy."""
+    max_m_warps = block_M // 16
+    max_n_warps = dim // 16
+    for m in range(1, min(max_m_warps, num_warps) + 1):
+        if num_warps % m != 0:
+            continue
+        n = num_warps // m
+        if n <= max_n_warps:
+            return True
+    return False
+
+
+def _smem_forward(block_M, block_N, dim):
+    """Forward SMEM in bytes: Q_shared + K_shared + V_shared + P_shared."""
+    return (block_M * dim + 2 * block_N * dim + block_M * block_N) * 2
+
+
+def _smem_backward(block_M, block_N, dim):
+    """Backward SMEM in bytes: Q_shared + K_shared + V_shared + P_shared (no dO_shared re-use)."""
+    return 4 * dim * (block_M + block_N) + 2 * block_M * block_N
+
+
+MAX_SMEM = 86000
