--- /dev/null
+++ b/flashinfer/backends/tilelang_fa_v100/_kernels_mla.py
@@ -0,0 +1,206 @@
+"""MLA paged decode kernel for V100 (SM70) using TileLang.
+
+Multi-Head Latent Attention (MLA) layout:
+  q_nope: [batch, num_heads, kv_lora_rank] — query latent (compressed)
+  q_pe:   [batch, num_heads, qk_rope_head_dim] — query RoPE
+  ckv:    [num_pages, page_size, kv_lora_rank] — compressed KV cache (no head dim!)
+  kpe:    [num_pages, page_size, qk_rope_head_dim] — RoPE KV cache (no head dim!)
+
+The RoPE component for attention scoring is:
+  S = (Q_noPE · CKV^T + Q_PE · KPE^T) * sm_scale
+
+We compute this as two separate GEMMs summed together:
+  S_qkv = Q_noPE · CKV^T          [block_M, block_N] x [block_N, kv_lora_rank]
+  S_pe  = Q_PE  · KPE^T           [block_M, block_N] x [block_N, qk_rope_dim]
+  S     = S_qkv + S_pe
+
+Then softmax(S) · CKV for the output (only the latent dimension is used).
+
+Each thread-block handles one (head, batch) pair.  Since CKV/KPE are
+head-less (shared across all heads), every head accesses the same cache.
+"""
+import tilelang
+import tilelang.language as T
+from tilelang.tileop.base import GemmWarpPolicy
+
+
+def _mla_decode_kernel_func(
+    batch,
+    heads,
+    kv_lora_rank,
+    qk_rope_head_dim,
+    page_block_size,
+    max_blocks_per_seq,
+    num_pages,
+    block_N=128,
+    num_stages=0,
+    threads=128,
+):
+    block_M = 16  # SM70 MMA minimum; row 0 = real Q, rows 1-15 = padding
+
+    @T.prim_func
+    def kernel(
+        Q_nope: T.Tensor([batch, heads, kv_lora_rank], T.float16),
+        Q_pe: T.Tensor([batch, heads, qk_rope_head_dim], T.float16),
+        CKV: T.Tensor([num_pages, page_block_size, kv_lora_rank], T.float16),
+        KPE: T.Tensor([num_pages, page_block_size, qk_rope_head_dim], T.float16),
+        bt: T.Tensor([batch, max_blocks_per_seq], T.int32),
+        sl: T.Tensor([batch], T.int32),
+        sm_scale: T.float32,
+        Out: T.Tensor([batch, heads, kv_lora_rank], T.float16),
+    ):
+        with T.Kernel(heads, batch, threads=threads) as (bx, bz):
+            # ── Shared memory ──────────────────────────────────────────
+            Qs_nope = T.alloc_shared([block_M, kv_lora_rank], T.float16)
+            Qs_pe = T.alloc_shared([block_M, qk_rope_head_dim], T.float16)
+            Ks_nope = T.alloc_shared([block_N, kv_lora_rank], T.float16)
+            Ks_pe = T.alloc_shared([block_N, qk_rope_head_dim], T.float16)
+            Vs = T.alloc_shared([block_N, kv_lora_rank], T.float16)
+            Ps = T.alloc_shared([block_M, block_N], T.float16)
+
+            # Accumulators
+            As = T.alloc_fragment([block_M, block_N], T.float32)
+            As_pe = T.alloc_fragment([block_M, block_N], T.float32)
+            Ac = T.alloc_fragment([block_M, block_N], T.float16)
+            Ao = T.alloc_fragment([block_M, kv_lora_rank], T.float32)
+
+            mi = T.alloc_fragment([block_M], T.float32)
+            mp = T.alloc_fragment([block_M], T.float32)
+            sf = T.alloc_fragment([block_M], T.float32)
+            rs = T.alloc_fragment([block_M], T.float32)
+            li = T.alloc_shared([block_M], T.float32)
+
+            seq_len = sl[bz]
+
+            T.copy(Q_nope[bz, bx, :], Qs_nope[0, :])
+            T.copy(Q_pe[bz, bx, :], Qs_pe[0, :])
+            T.fill(Ao, 0)
+            T.fill(mi, -T.infinity(T.float32))
+            T.fill(li, 0)
+
+            num_blocks = T.ceildiv(seq_len, block_N)
+            for k in T.Pipelined(num_blocks, num_stages=num_stages):
+                # ── Load CKV tile ──────────────────────────────────────
+                T.clear(Ks_nope)
+                for i, j in T.Parallel(block_N, kv_lora_rank):
+                    gkv = k * block_N + i
+                    if gkv < seq_len:
+                        lp = T.floordiv(gkv, page_block_size)
+                        off = gkv - lp * page_block_size
+                        phys = bt[bz, lp]
+                        Ks_nope[i, j] = CKV[phys, off, j]
+
+                # ── Load KPE tile ──────────────────────────────────────
+                T.clear(Ks_pe)
+                for i, j in T.Parallel(block_N, qk_rope_head_dim):
+                    gkv = k * block_N + i
+                    if gkv < seq_len:
+                        lp = T.floordiv(gkv, page_block_size)
+                        off = gkv - lp * page_block_size
+                        phys = bt[bz, lp]
+                        Ks_pe[i, j] = KPE[phys, off, j]
+
+                # ── S_noPE = Q_noPE · CKV^T ───────────────────────────
+                T.gemm(
+                    Qs_nope, Ks_nope, As, transpose_B=True, policy=GemmWarpPolicy.FullRow
+                )
+
+                # ── S_pe = Q_PE · KPE^T ───────────────────────────────
+                T.gemm(
+                    Qs_pe, Ks_pe, As_pe, transpose_B=True, policy=GemmWarpPolicy.FullRow
+                )
+
+                # ── S = S_noPE + S_pe ─────────────────────────────────
+                for i, j in T.Parallel(block_M, block_N):
+                    As[i, j] = As[i, j] + As_pe[i, j]
+                    if k * block_N + j >= seq_len:
+                        As[i, j] = -T.infinity(T.float32)
+
+                # ── Online softmax + rescale ───────────────────────────
+                T.copy(mi, mp)
+                T.reduce_max(As, mi, dim=1, clear=False)
+                for i in T.Parallel(block_M):
+                    mi[i] = T.if_then_else(
+                        mi[i] == -T.infinity(T.float32),
+                        T.cast(0, T.float32),
+                        mi[i],
+                    )
+                for i in T.Parallel(block_M):
+                    mi[i] = T.max(mi[i], mp[i])
+                for i in T.Parallel(block_M):
+                    sf[i] = T.exp(mp[i] * sm_scale - mi[i] * sm_scale)
+                    li[i] *= sf[i]
+                for i, j in T.Parallel(block_M, kv_lora_rank):
+                    Ao[i, j] *= sf[i]
+                for i, j in T.Parallel(block_M, block_N):
+                    As[i, j] = T.exp(As[i, j] * sm_scale - mi[i] * sm_scale)
+                T.reduce_sum(As, rs, dim=1)
+                for i in T.Parallel(block_M):
+                    li[i] += rs[i]
+
+                # ── Load CKV tile again for P · V ─────────────────────
+                T.clear(Vs)
+                for i, j in T.Parallel(block_N, kv_lora_rank):
+                    gkv2 = k * block_N + i
+                    if gkv2 < seq_len:
+                        lp2 = T.floordiv(gkv2, page_block_size)
+                        off2 = gkv2 - lp2 * page_block_size
+                        phys2 = bt[bz, lp2]
+                        Vs[i, j] = CKV[phys2, off2, j]
+
+                for i, j in T.Parallel(block_M, block_N):
+                    Ps[i, j] = T.cast(As[i, j], T.float16)
+                T.copy(Ps, Ac)
+                T.gemm(Ac, Vs, Ao, policy=GemmWarpPolicy.Square)
+
+            # ── Store output ───────────────────────────────────────────
+            for i, j in T.Parallel(block_M, kv_lora_rank):
+                if i == 0:
+                    Out[bz, bx, j] = T.cast(Ao[i, j] / li[i], T.float16)
+
+    return kernel
+
+
+_MLA_JIT = tilelang.jit(out_idx=[7])(_mla_decode_kernel_func)
+_MLA_CACHE = {}
+
+_MLA_BEST_CONFIGS = {
+    64:   dict(block_N=64,  threads=64,  num_stages=0),
+    128:  dict(block_N=128, threads=128, num_stages=0),
+    256:  dict(block_N=128, threads=128, num_stages=0),
+    512:  dict(block_N=64,  threads=128, num_stages=0),
+}
+
+
+def get_mla_decode_kernel(
+    batch,
+    heads,
+    kv_lora_rank,
+    qk_rope_head_dim,
+    block_size,
+    num_pages,
+    max_blocks,
+):
+    """Return compiled MLA decode TileLang kernel.
+
+    Compiles once per unique (batch, heads, dims, block_size, pages, blocks).
+    """
+    cfg = _MLA_BEST_CONFIGS.get(kv_lora_rank, dict(block_N=128, threads=128, num_stages=0))
+    key = (
+        batch, heads, kv_lora_rank, qk_rope_head_dim,
+        block_size, num_pages, max_blocks,
+        cfg["block_N"], cfg["threads"], cfg["num_stages"],
+    )
+    if key not in _MLA_CACHE:
+        kt = tilelang.jit(out_idx=[7])(_mla_decode_kernel_func).compile(
+            batch=batch,
+            heads=heads,
+            kv_lora_rank=kv_lora_rank,
+            qk_rope_head_dim=qk_rope_head_dim,
+            page_block_size=block_size,
+            max_blocks_per_seq=max_blocks,
+            num_pages=num_pages,
+            **cfg,
+        )
+        _MLA_CACHE[key] = kt
+    return _MLA_CACHE[key]
diff --git a/flashinfer/backends/tilelang_fa_v100/_kernels_paged.py b/flashinfer/backends/tilelang_fa_v100/_kernels_paged.py
