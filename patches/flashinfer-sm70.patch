+  __device__ __forceinline__ T operator()(const T& a, const T& b) const {
+    return a > b ? a : b;
+  }
+};
+
+struct MinReduceOpF {
+  template <typename T>
+  __device__ __forceinline__ T operator()(const T& a, const T& b) const {
+    return a < b ? a : b;
+  }
+};
