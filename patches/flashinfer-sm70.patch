+                if bx * block_M + qi < seq_q:
+                    Q_shared[qi, qj] = Q[bz, by, bx * block_M + qi, qj]
+
+            T.fill(acc_o, 0)
+            T.fill(m_i, -T.infinity(T.float32))
+            T.fill(l_i, 0)
+
+            loop_end = (
+                T.min(T.ceildiv(seq_kv, block_N), T.ceildiv((bx + 1) * block_M, block_N))
