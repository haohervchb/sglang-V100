@@ -0,0 +1,211 @@
+"""TileLang ragged prefill kernel for SM70 (V100).
+
+Flat K/V tensors indexed by kv_indptr (no block table).
+"""
+import tilelang
+import tilelang.language as T
+from tilelang.tileop.base import GemmWarpPolicy
+
+from ._utils import _smem_forward, MAX_SMEM
+
+# ═══════════════════════════════════════════════════════════════════════════
+# Ragged Prefill Kernel (varlen attention with flat K/V)
+#
+# Input layout:
+#   Q      [total_q,   heads,   dim]
+#   K      [total_kv,  heads_kv, dim]
+#   V      [total_kv,  heads_kv, dim]
+#   qo_indptr [batch+1] — Q token prefix offsets
+#   kv_indptr [batch+1] — KV token prefix offsets
+# ═══════════════════════════════════════════════════════════════════════════
+
+
+def _ragged_kernel_func(
+    batch, heads, heads_kv, dim, total_q, total_kv, is_causal,
+    block_M=64, block_N=128, num_stages=0, threads=256,
+):
+    smem = _smem_forward(block_M, block_N, dim)
+    if smem > MAX_SMEM:
+        block_N = 64
+        smem = _smem_forward(block_M, block_N, dim)
+        if smem > MAX_SMEM:
+            block_M = 16
+        smem = _smem_forward(block_M, block_N, dim)
+        assert smem <= MAX_SMEM, f"Shared memory {smem} exceeds limit {MAX_SMEM}"
+
+    @T.prim_func
+    def main(
+        Q: T.Tensor([total_q, heads, dim], T.float16),
+        K: T.Tensor([total_kv, heads_kv, dim], T.float16),
+        V: T.Tensor([total_kv, heads_kv, dim], T.float16),
+        qo_indptr: T.Tensor([batch + 1], T.int32),
+        kv_indptr: T.Tensor([batch + 1], T.int32),
+        sm_scale: T.float32,
+        Output: T.Tensor([total_q, heads, dim], T.float16),
+    ):
+        with T.Kernel(T.ceildiv(total_q, block_M), heads, batch, threads=threads) as (bx, by, bz):
+            Q_shared = T.alloc_shared([block_M, dim], T.float16)
+            K_shared = T.alloc_shared([block_N, dim], T.float16)
+            V_shared = T.alloc_shared([block_N, dim], T.float16)
+            P_shared = T.alloc_shared([block_M, block_N], T.float16)
+
+            acc_s = T.alloc_fragment([block_M, block_N], T.float32)
+            acc_s_cast = T.alloc_fragment([block_M, block_N], T.float16)
+            acc_o = T.alloc_fragment([block_M, dim], T.float32)
+            m_i = T.alloc_fragment([block_M], T.float32)
+            m_prev = T.alloc_fragment([block_M], T.float32)
+            l_i = T.alloc_fragment([block_M], T.float32)
+            sf = T.alloc_fragment([block_M], T.float32)
+            row_sum = T.alloc_fragment([block_M], T.float32)
+
+            kv_head = by // (heads // heads_kv)
+            q_len = qo_indptr[bz + 1] - qo_indptr[bz]
+            kv_len = kv_indptr[bz + 1] - kv_indptr[bz]
+
+            # Base offset in flat tensor
+            q_off = qo_indptr[bz]
+            kv_off = kv_indptr[bz]
+
+            start_q = bx * block_M
+
+            # Bounds-checked Q copy
+            T.clear(Q_shared)
+            for qi, qj in T.Parallel(block_M, dim):
+                if bx * block_M + qi < q_len:
+                    Q_shared[qi, qj] = Q[q_off + bx * block_M + qi, by, qj]
+            T.fill(acc_o, 0)
+            T.fill(m_i, -T.infinity(T.float32))
+            T.fill(l_i, 0)
+
+            # Compute loop bound
+            kv_blocks = T.ceildiv(kv_len, block_N)
+
+            if is_causal:
+                kv_blocks = T.min(
+                    kv_blocks,
+                    T.ceildiv(bx * block_M + block_M, block_N),
+                )
+
+            for kv in range(kv_blocks):
+                T.clear(K_shared)
+                for i, j in T.Parallel(block_N, dim):
+                    gkv = kv * block_N + i
+                    if gkv < kv_len:
+                        K_shared[i, j] = K[kv_off + gkv, kv_head, j]
+
+                if is_causal:
+                    for i, j in T.Parallel(block_M, block_N):
+                        q_pos = bx * block_M + i
+                        kv_pos = kv * block_N + j
+                        causal_ok = kv_pos < q_pos
+                        seq_ok = kv_pos < kv_len
+                        acc_s[i, j] = T.if_then_else(
+                            causal_ok & seq_ok, 0, -T.infinity(acc_s.dtype),
+                        )
+                else:
+                    for i, j in T.Parallel(block_M, block_N):
+                        acc_s[i, j] = T.if_then_else(
+                            kv * block_N + j < kv_len,
+                            0,
+                            -T.infinity(acc_s.dtype),
+                        )
+
+                T.gemm(
+                    Q_shared,
+                    K_shared,
+                    acc_s,
+                    transpose_B=True,
+                    policy=GemmWarpPolicy.FullRow,
+                )
+                T.copy(m_i, m_prev)
+                T.reduce_max(acc_s, m_i, dim=1, clear=False)
+                for i in T.Parallel(block_M):
+                    m_i[i] = T.if_then_else(
+                        m_i[i] == -T.infinity(T.float32),
+                        T.cast(0, T.float32),
+                        m_i[i],
+                    )
+                for i in T.Parallel(block_M):
+                    m_i[i] = T.max(m_i[i], m_prev[i])
+                for i in T.Parallel(block_M):
+                    sf[i] = T.exp(m_prev[i] * sm_scale - m_i[i] * sm_scale)
+                    l_i[i] *= sf[i]
+                for i, j in T.Parallel(block_M, dim):
+                    acc_o[i, j] *= sf[i]
+                for i, j in T.Parallel(block_M, block_N):
+                    acc_s[i, j] = T.exp(acc_s[i, j] * sm_scale - m_i[i] * sm_scale)
+                T.reduce_sum(acc_s, row_sum, dim=1)
+                for i in T.Parallel(block_M):
+                    l_i[i] += row_sum[i]
+
+                T.clear(V_shared)
+                for i, j in T.Parallel(block_N, dim):
+                    gkv2 = kv * block_N + i
+                    if gkv2 < kv_len:
+                        V_shared[i, j] = V[kv_off + gkv2, kv_head, j]
+
+                for i, j in T.Parallel(block_M, block_N):
+                    P_shared[i, j] = T.cast(acc_s[i, j], T.float16)
+                T.copy(P_shared, acc_s_cast)
+                T.gemm(
+                    acc_s_cast, V_shared, acc_o, policy=GemmWarpPolicy.Square,
+                )
+
+            # Write output with bounds check
+            for i, j in T.Parallel(block_M, dim):
+                if bx * block_M + i < q_len:
+                    l_i_safe = T.if_then_else(l_i[i] == 0, 1, l_i[i])
+                    Output[q_off + bx * block_M + i, by, j] = T.cast(acc_o[i, j] / l_i_safe, T.float16)
+
+    return main
+
+
+# ═══════════════════════════════════════════════════════════════════════════
+# Kernel compilation + caching
+# ═══════════════════════════════════════════════════════════════════════════
+
+_RAGGED_KERNEL_CACHE = {}
+
+_RAGGED_BEST_CONFIGS = {
+    64: dict(block_M=32, block_N=128, threads=256, num_stages=0),
+    128: dict(block_M=32, block_N=128, threads=256, num_stages=0),
+    256: dict(block_M=64, block_N=32, threads=256, num_stages=0),
+}
+
+
+def get_ragged_kernel(
+    batch, heads, heads_kv, dim, total_q, total_kv, causal,
+):
+    """Return compiled ragged kernel. Compiles once per signature."""
+    cfg = _RAGGED_BEST_CONFIGS.get(
+        dim, dict(block_M=32, block_N=128, threads=256, num_stages=0),
+    )
+    key = (
+        total_q,
+        total_kv,
+        heads,
+        heads_kv,
+        dim,
+        batch,
+        causal,
+        cfg["block_M"],
+        cfg["block_N"],
+        cfg["threads"],
+        cfg["num_stages"],
+    )
+    if key not in _RAGGED_KERNEL_CACHE:
+        func = _ragged_kernel_func(
+            batch,
+            heads,
+            heads_kv,
+            dim,
+            total_q,
+            total_kv,
+            causal,
+            **cfg,
+        )
+        kt = tilelang.jit(out_idx=[7])(func).compile(
+            params={},
+        )
+        _RAGGED_KERNEL_CACHE[key] = kt
+    return _RAGGED_KERNEL_CACHE[key]
