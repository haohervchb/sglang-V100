index 00000000..bd2fab6d
--- /dev/null
+++ b/flashinfer/backends/fa_v100/_paged.py
@@ -0,0 +1,240 @@
+"""FA-V100 (ai_bond) backend for SM70 (V100).
+
+Calls precompiled flash_attn_v100_cuda kernels.
+Supports: causal, softcap, GQA, paged KV (3D [N,H,D], page_block_size=1).
+"""
+import math
+import torch
+from typing import Optional, Tuple
+
+
+def _is_available() -> bool:
+    try:
+        import flash_attn_v100_cuda  # noqa: F401
+        return True
+    except ImportError:
+        return False
+
+
+def _import_kernel():
+    import flash_attn_v100_cuda
+    return flash_attn_v100_cuda
+
+
+# ==============================================================================
+# DECODE: Batch decode, 3D paged KV cache [N, H, D] + block_table [B, max_seq]
+# ==============================================================================
+
+def fa_v100_decode_forward(
+    q: torch.Tensor,              # [B, Hq, D] NHD
+    k_cache: torch.Tensor,        # [N, Hv, D] flat
+    v_cache: torch.Tensor,        # [N, Hv, D] flat
+    block_table: torch.Tensor,    # [B, max_seq] int32
+    kv_lens: torch.Tensor,        # [B] int32 — per-request KV lengths
+    block_size: int = 1,          # page_size (sglang defaults to 1)
+    num_kv_heads: int = None,     # Hv, inferred from k_cache if None
+    softmax_scale: float = None,  # 1/sqrt(D) by default
+    logits_soft_cap: float = 0.0,
+    out: torch.Tensor = None,     # optional pre-allocated [B, Hq, D]
+    # Graph-safe overrides: pass from plan() to skip .item() / allocation in run()
+    cu_seqlens_q: Optional[torch.Tensor] = None,
+    cu_seqlens_k: Optional[torch.Tensor] = None,
+    max_seq_k: Optional[int] = None,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    """Paged decode via varlen_fwd with block_table.
+
+    Uses FA-V100's varlen_fwd paged mode (IS_PAGED=1) which natively
+    handles scatter indexing via block_table[block, token_idx] -> kv_cache[token_slot, H, D].
+
+    Returns (out, lse) where lse shape is [Hq, B].
+    """
+    m = _import_kernel()
+    B, Hq, D = q.shape
+    Hk = num_kv_heads or k_cache.shape[1]
+
+    if softmax_scale is None:
+        softmax_scale = 1.0 / math.sqrt(D)
+
+    if cu_seqlens_q is None:
+        cu_seqlens_q = torch.arange(B + 1, dtype=torch.int32, device=q.device)
+
+    if cu_seqlens_k is None:
+        kv_lens_i32 = kv_lens if kv_lens.dtype == torch.int32 else kv_lens.to(torch.int32)
+        cu_seqlens_k = torch.zeros(B + 1, dtype=torch.int32, device=q.device)
+        cu_seqlens_k[1:] = torch.cumsum(kv_lens_i32, dim=0)
+        if max_seq_k is None:
+            max_seq_k = kv_lens_i32.max().item()
+
+    out_kernel, lse_kernel, *_ = m.varlen_fwd(
+        q.contiguous().to(torch.float16),
+        k_cache, v_cache,
+        out if out is not None else None,
+        cu_seqlens_q, cu_seqlens_k,
+        None, None,
+        block_table, None,
+        1, max_seq_k,
+        0.0, softmax_scale, False,
+        False,    # decode is non-causal
+        -1, -1, logits_soft_cap,
+        False, None, 0,
+    )
+
+    # P0: convert natural-log LSE to base-2 (matching FA2's ptx_log2)
+    lse_kernel.div_(math.log(2))
+
+    return out_kernel, lse_kernel
+
+
+# ==============================================================================
+# PAGED PREFILL: Extend with cached prefix, 3D paged KV + block_table
+# ==============================================================================
+
+def fa_v100_paged_forward(
+    q: torch.Tensor,              # [Tq, Hq, D]
+    k_cache: torch.Tensor,        # [N, Hv, D] flat
+    v_cache: torch.Tensor,        # [N, Hv, D] flat
+    block_table: torch.Tensor,    # [B, max_seq] int32
+    kv_lens: torch.Tensor,        # [B] int32 — cached KV lengths
+    qo_indptr: torch.Tensor,      # [B+1] int32 — Q token offsets
+    prefix_kv_lens: torch.Tensor, # [B] int32 — 0 = pure new, >0 = has prefix
+    block_size: int = 1,
+    num_kv_heads: int = None,     # Hv
+    softmax_scale: float = None,
+    logits_soft_cap: float = 0.0,
+    causal: bool = False,
+    window_left: int = -1,
+    window_right: int = -1,
+    out: torch.Tensor = None,
+    # Graph-safe overrides: pass from plan() to skip .item() / allocation in run()
+    cu_seqlens_k: Optional[torch.Tensor] = None,
+    max_seq_q: Optional[int] = None,
+    max_seq_k: Optional[int] = None,
+    has_prefix_cache: Optional[bool] = None,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    """Paged prefill (cached prefix) via varlen_fwd with block_table.
+
+    FA-V100 varlen_fwd leftpad_k is a dead parameter — never dereferenced in kernel.
+    With causal=True and cached prefix (kv_len > sq_len), the causal mask clips
+    cached tokens because it treats Q[i] as seeing only K[0..i].
+    Fix: disable causal when any request has cached prefix.
+    """
+    m = _import_kernel()
+    Tq = q.shape[0]
+    D = q.shape[2]
+    B = block_table.shape[0]
+
+    if softmax_scale is None:
+        softmax_scale = 1.0 / math.sqrt(D)
+
+    if out is None:
+        out = torch.empty_like(q, dtype=torch.float16)
+
+    cu_seqlens_q = qo_indptr if qo_indptr.dtype == torch.int32 else qo_indptr.to(torch.int32)
+
+    kv_lens_i32 = kv_lens if kv_lens.dtype == torch.int32 else kv_lens.to(torch.int32)
+
+    if cu_seqlens_k is not None:
+        # Graph-safe: pre-allocated buffer, just copy cumsum
+        cu_seqlens_k[0] = 0
+        cu_seqlens_k[1:] = kv_lens_i32.cumsum(0)
+    else:
+        cu_seqlens_k = torch.zeros(B + 1, dtype=torch.int32, device=q.device)
+        cu_seqlens_k[1:] = torch.cumsum(kv_lens_i32, dim=0)
+        if max_seq_k is None:
+            max_seq_k = kv_lens_i32.max().item()
+
+    if max_seq_q is None:
+        max_seq_q = (cu_seqlens_q[1:] - cu_seqlens_q[:-1]).max().item()
+
+    # Safety: max_seq_q can never exceed the actual Q dimension
+    if max_seq_q > Tq:
+        max_seq_q = Tq
+
+    # Disable causal when any request has cached prefix (kv_len > sq_len)
+    # because leftpad_k is dead in the kernel.
+    if causal:
+        if has_prefix_cache is not None:
+            has_prefix = has_prefix_cache
+        else:
+            sq_lens = cu_seqlens_q[1:] - cu_seqlens_q[:-1]
+            has_prefix = (kv_lens_i32 > sq_lens).any().item()
+        if has_prefix:
+            causal = False
+
+    out_kernel, lse_kernel, *_ = m.varlen_fwd(
+        q.contiguous().to(torch.float16), k_cache, v_cache,
+        out, cu_seqlens_q, cu_seqlens_k,
+        None, None, block_table, None,
+        max_seq_q, max_seq_k, 0.0, softmax_scale, False,
+        causal, window_left, window_right, logits_soft_cap, False, None, 0,
+    )
+
+    # P0: convert natural-log LSE to base-2 (matching FA2's ptx_log2)
+    lse_kernel.div_(math.log(2))
+
+    return out_kernel, lse_kernel
+
+
+# ==============================================================================
+# RAGGED PREFILL: Pure new tokens, no cached KV
+# ==============================================================================
+
+def fa_v100_ragged_forward(
+    q: torch.Tensor,              # [Tq, Hq, D]
+    k: torch.Tensor,              # [Tk, Hv, D]
+    v: torch.Tensor,              # [Tk, Hv, D]
+    qo_indptr: torch.Tensor,      # [B+1] int32
+    kv_indptr: torch.Tensor,      # [B+1] int32
+    prefix_kv_lens: torch.Tensor, # [B] — unused for pure ragged
+    num_kv_heads: int = None,
+    softmax_scale: float = None,
+    logits_soft_cap: float = 0.0,
+    causal: bool = True,
+    window_left: int = -1,
+    window_right: int = -1,
+    out: torch.Tensor = None,
+    # Graph-safe overrides: pass from plan() to skip .item() in run()
+    max_seq_q: Optional[int] = None,
+    max_seq_k: Optional[int] = None,
+    cu_seqlens_q: Optional[torch.Tensor] = None,
+    cu_seqlens_k: Optional[torch.Tensor] = None,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    """Ragged prefill via varlen_fwd non-paged."""
+    m = _import_kernel()
+    Tq = q.shape[0]
+    Tk = k.shape[0]
+    Hq = q.shape[1]
+    D = q.shape[2]
+    Hk = num_kv_heads or k.shape[1]
+    B = qo_indptr.shape[0] - 1
+
+    if softmax_scale is None:
+        softmax_scale = 1.0 / math.sqrt(D)
+
+    if out is None:
+        out = torch.empty_like(q, dtype=torch.float16)
+
+    if cu_seqlens_q is None:
+        cu_seqlens_q = qo_indptr if qo_indptr.dtype == torch.int32 else qo_indptr.to(torch.int32)
+    if cu_seqlens_k is None:
+        cu_seqlens_k = kv_indptr if kv_indptr.dtype == torch.int32 else kv_indptr.to(torch.int32)
+
+    if max_seq_q is None:
+        max_seq_q = (cu_seqlens_q[1:] - cu_seqlens_q[:-1]).max().item()
+    if max_seq_k is None:
+        max_seq_k = (cu_seqlens_k[1:] - cu_seqlens_k[:-1]).max().item()
+
+    out_kernel, lse_kernel, *_ = m.varlen_fwd(
+        q.contiguous().to(torch.float16),
+        k.contiguous(),
+        v.contiguous(),
+        out, cu_seqlens_q, cu_seqlens_k,
+        None, None, None, None,  # no block_table, no alibi
+        max_seq_q, max_seq_k, 0.0, softmax_scale, False,
+        causal, window_left, window_right, logits_soft_cap, False, None, 0,
+    )
+
+    # P0: convert natural-log LSE to base-2 (matching FA2's ptx_log2)
+    lse_kernel.div_(math.log(2))
+
+    return out_kernel, lse_kernel
