+"""Backends — auto-registers TileLang and FA-V100 for SM70 (V100)."""
+import torch
+
+
+def _is_sm70() -> bool:
+    if not torch.cuda.is_available():
+        return False
+    dev = torch.cuda.current_device()
+    major, _ = torch.cuda.get_device_capability(dev)
+    return major == 7
+
+
+def is_tilelang_available() -> bool:
+    try:
+        import tilelang  # noqa: F401
+        return True
+    except ImportError:
+        return False
+
+
+def is_fa_v100_available() -> bool:
+    try:
+        import flash_attn_v100_cuda  # noqa: F401
+        return True
+    except ImportError:
+        return False
+
+
+_backend_available = {}
+
+
+def get_tilelang_backend():
+    """Return TileLang functions, or raise if not available.
+
+    Returns
+    -------
+    Tuple of (flash_attn, paged_fwd, decode_fwd, ragged_fwd, mla_decode_fwd)
+    """
+    global _backend_available
+    if "tilelang" not in _backend_available:
+        _backend_available["tilelang"] = is_tilelang_available()
+    if not _backend_available["tilelang"]:
+        raise RuntimeError(
+            "tilelang backend is not available. "
+            "pip install tilelang-tvm-nightly"
+        )
+    from .tilelang_fa_v100 import (  # noqa: E402
+        tilelang_flash_attn_func,
+        tilelang_paged_forward,
+        tilelang_decode_forward,
+        tilelang_ragged_forward,
+        tilelang_mla_decode_forward,
+    )
+    return (
+        tilelang_flash_attn_func,
+        tilelang_paged_forward,
+        tilelang_decode_forward,
+        tilelang_ragged_forward,
+        tilelang_mla_decode_forward,
+    )
+
+
+def get_fa_v100_backend():
+    """Return FA-V100 functions, or raise if not available.
+
+    Returns
+    -------
+    Tuple of (flash_attn, paged_fwd, decode_fwd, ragged_fwd)
+    """
+    global _backend_available
+    if "fa_v100" not in _backend_available:
+        _backend_available["fa_v100"] = is_fa_v100_available()
+    if not _backend_available["fa_v100"]:
+        raise RuntimeError(
+            "fa_v100 backend is not available. "
+            "pip install flash-attn-v100 or build from source."
+        )
+    from .fa_v100 import (  # noqa: E402
+        fa_v100_paged_forward,
+        fa_v100_decode_forward,
+        fa_v100_ragged_forward,
+    )
+    return (
+        None,  # flash_attn (dense training not needed for inference)
+        fa_v100_paged_forward,
+        fa_v100_decode_forward,
+        fa_v100_ragged_forward,
+    )
